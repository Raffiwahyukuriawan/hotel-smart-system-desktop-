<Page x:Class="HSS_desktop.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA"
      Title="Dashboard">


    <ScrollViewer Padding="20">
        <StackPanel>

            <Border x:Name="BannerBorder" CornerRadius="20" Margin="0,0,0,20" Padding="0" Height="200">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Selamat Datang di Hotel HSS"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
                        <TextBlock Text="Dashboard Management System"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Statistik -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- CARD 1 -->
                <Border Background="White" CornerRadius="10" Margin="8" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Total Tamu Aktif"
                           FontWeight="Bold"
                           FontSize="14"
                           DockPanel.Dock="Left"/>
                            <TextBlock Text="👤"
                           FontSize="16"
                           Foreground="Gray"
                           HorizontalAlignment="Right"/>
                        </DockPanel>

                        <TextBlock x:Name="TotalTamuText"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,10,0,5"
                           Text="0"/>

                        <TextBlock Text="Jumlah seluruh tamu&#x0a;yang menginap"
           Foreground="Gray"
           FontSize="12"/>

                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Margin="8" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Kamar Tersedia"
                       FontWeight="Bold"
                       FontSize="14"/>
                            <TextBlock Text="🛏️"
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Right"/>
                        </DockPanel>

                        <TextBlock x:Name="KamarText"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,10,0,5"
                   Text="0/0"/>

                        <TextBlock Text="Jumlah total kamar&#x0a;yang dipesan"
           Foreground="Gray"
           FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- CARD 3 -->
<Border Background="White" CornerRadius="10" Margin="8" Padding="20">
    <Border.Effect>
        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
    </Border.Effect>
    <StackPanel>
        <DockPanel>
            <TextBlock Text="Pesanan Hari Ini"
                       FontWeight="Bold"
                       FontSize="14"/>
            <TextBlock Text="🍽️"
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Right"/>
        </DockPanel>

        <TextBlock x:Name="TotalPesananText"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,10,0,5"/>

                        <TextBlock Text="Jumlah seluruh pesanan&#x0a;makanan dan minuman"
           Foreground="Gray"
           FontSize="12"/>
                    </StackPanel>
</Border>

                <Border Background="White" CornerRadius="10" Margin="8" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Total Menu"
                       FontWeight="Bold"
                       FontSize="14"/>
                            <TextBlock Text="🍽️"
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Nilai dinamis -->
                        <TextBlock x:Name="TotalMenuText"
                   Text="0"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,10,0,5"/>

                        <TextBlock Text="Jumlah seluruh menu&#x0a;makanan dan minuman"
           Foreground="Gray"
           FontSize="12"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Konten bawah: Grafik + Aktivitas -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Kolom kiri -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Aktivitas Terbaru (Kolom Kiri)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="AktivitasListKiri">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Icon}" FontSize="18" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock><Run Text="{Binding Nama}"/></TextBlock>
                                                <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding Waktu}" Foreground="Gray" FontSize="11"/>
                                            </StackPanel>
                                            <Border Background="{Binding StatusColor}" CornerRadius="15" Padding="5,2"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Background="Transparent" 
        CornerRadius="1" 
        Padding="5,2"
        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11"/>
                                                </Border>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Kolom kanan -->
                <Border Background="White" CornerRadius="10" Padding="20" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Aktivitas Terbaru (Kolom Kanan)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="AktivitasListKanan">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Icon}" FontSize="18" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock><Run Text="{Binding Nama}"/></TextBlock>
                                                <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding Waktu}" Foreground="Gray" FontSize="11"/>
                                            </StackPanel>
                                            <Border Background="{Binding StatusColor}" CornerRadius="15" Padding="5,2"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Aksi Cepat ===== -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,20,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Aksi Cepat" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <UniformGrid Columns="4" Rows="1" Margin="0" HorizontalAlignment="Center" Width="806">

                        <!-- Tombol 1: Tambah Kamar Baru -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TambahKamarBaru_Click">
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Background="White">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="#E0E7FF" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
                                        <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Tambah Kamar Baru" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Tombol 2: Lihat Menu -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="LihatMenu_Click">
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Background="White">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="#FEF3C7" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
                                        <TextBlock Text="🧾" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Lihat Menu" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Tombol 3: Tambah Menu Baru -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TambahMenuBaru_Click">
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Background="White">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="#D1FAE5" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
                                        <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Tambah Meja Baru" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Tombol 4: Lihat Invoice -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="LihatInvoice_Click">
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Background="White">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="#EDE9FE" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
                                        <TextBlock Text="📊" FontSize="18" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Lihat Invoice" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
