<Window x:Class="HSS_desktop.TambahAbout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Data Hotel"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White"
                CornerRadius="10"
                Padding="25"
                Width="480"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Judul -->
                    <TextBlock Text="Tambah Data Hotel"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,20"/>

                    <!-- Nama Hotel -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="🏨 Nama Hotel"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="5,0,0,5"
                                   Foreground="#111827"/>
                        <TextBox x:Name="txtNamaHotel"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Width="425"/>
                    </StackPanel>

                    <!-- Foto -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="🖼️ Foto"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="5,0,0,5"
                                   Foreground="#111827"/>
                        <TextBox x:Name="txtFoto"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Width="425"/>
                    </StackPanel>

                    <!-- Alamat -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="📍 Alamat"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="5,0,0,5"
                                   Foreground="#111827"/>
                        <TextBox x:Name="txtAlamat"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Width="425"/>
                    </StackPanel>

                    <!-- No Telepon -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="📞 No. Telepon"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="5,0,0,5"
                                   Foreground="#111827"/>
                        <TextBox x:Name="txtNoTelp"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Width="425"
                                 PreviewTextInput="txtNoTelp_PreviewTextInput"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="✉️ Email"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="5,0,0,5"
                                   Foreground="#111827"/>
                        <TextBox x:Name="txtEmail"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Width="425"/>
                    </StackPanel>

                    <!-- Kelas -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="⭐ Kelas Hotel"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="5,0,0,5"
                                   Foreground="#111827"/>
                        <TextBox x:Name="txtKelas"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Width="425"/>
                    </StackPanel>

                    <!-- Deskripsi -->
                    <StackPanel Margin="0 0 0 20">
                        <TextBlock Text="📝 Deskripsi"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="5,0,0,5"
                                   Foreground="#111827"/>
                        <TextBox x:Name="txtDeskripsi"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 VerticalScrollBarVisibility="Auto"
                                 Width="425"/>
                    </StackPanel>

                    <!-- Tombol -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Content="Batal"
                                Width="90"
                                Height="32"
                                Background="White"
                                Foreground="#374151"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="Batal_Click"
                                FontWeight="Bold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="6,0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Simpan"
                                x:Name="btnSimpan"
                                Width="90"
                                Height="32"
                                Margin="10,0,0,0"
                                Background="Black"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Simpan_Click"
                                FontWeight="Bold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="6,0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E40AF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
