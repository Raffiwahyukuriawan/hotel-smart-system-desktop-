<Window x:Class="HSS_desktop.UpdateAbout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update About"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="10" Padding="25" Width="480" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Judul -->
                    <TextBlock Text="Update Informasi Hotel"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,20"/>

                    <TextBox x:Name="txtId" Visibility="Collapsed"/>

                    <!-- Nama Hotel -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="🏨 Nama Hotel"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="5,0,0,5"/>
                        <TextBox x:Name="txtNamaHotel"
                                 Width="425"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Text="Nama Hotel"/>
                    </StackPanel>

                    <!-- Alamat -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="📍 Alamat"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="5,0,0,5"/>
                        <TextBox x:Name="txtAlamat"
                                 Width="425"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Text="Alamat"/>
                    </StackPanel>

                    <!-- Nomor Telepon -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="📞 Nomor Telepon"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="5,0,0,5"/>
                        <TextBox x:Name="txtNoTelp"
                                 Width="425"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Text="Nomor Telepon"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="✉️ Email"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="5,0,0,5"/>
                        <TextBox x:Name="txtEmail"
                                 Width="425"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Text="Email"/>
                    </StackPanel>

                    <!-- Kelas -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="⭐ Kelas Hotel"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="5,0,0,5"/>
                        <TextBox x:Name="txtKelas"
                                 Width="425"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Text="Kelas (contoh: Bintang 5)"/>
                    </StackPanel>

                    <!-- URL Foto -->
                    <StackPanel Margin="0 0 0 15">
                        <TextBlock Text="🖼️ URL Foto"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="5,0,0,5"/>
                        <TextBox x:Name="txtFotoUrl"
                                 Width="425"
                                 MaxLength="1000"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 Text="https://contoh.com/foto.jpg"/>
                    </StackPanel>

                    <!-- Preview Foto -->
                    <Image x:Name="imgPreview"
                           Width="150"
                           Height="100"
                           Stretch="UniformToFill"
                           Margin="0,5,0,20"
                           HorizontalAlignment="Center"/>

                    <!-- Deskripsi -->
                    <StackPanel Margin="0 0 0 20">
                        <TextBlock Text="📝 Deskripsi"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="5,0,0,5"/>
                        <TextBox x:Name="txtDeskripsi"
                                 Width="425"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="90"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Deskripsi Hotel"/>
                    </StackPanel>

                    <!-- Tombol -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Content="Batal"
                                Width="90" Height="32"
                                Background="White"
                                Foreground="#374151"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="Batal_Click"
                                FontWeight="Bold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnUpdate"
                                Content="Update"
                                Width="90" Height="32"
                                Margin="10,0,0,0"
                                Background="Black"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Update_Click"
                                FontWeight="Bold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E40AF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
