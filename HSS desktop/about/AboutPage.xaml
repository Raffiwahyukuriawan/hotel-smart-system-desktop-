<Page x:Class="HSS_desktop.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tentang Hotel"
      Width="1070">

    <ScrollViewer Padding="20" Width="1070">
        <StackPanel>
            <!-- Card Container -->
            <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>

                    <!-- Header + tombol -->
                    <DockPanel Margin="0,0,0,15">
                        <TextBlock Text="Manajemen Tentang Hotel"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <Button Content="＋ Tambah Data"
                                Background="#111827"
                                Foreground="White"
                                Padding="10,5"
                                FontWeight="Bold"
                                Width="160"
                                Height="35"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Click="TambahAbout_Click"/>
                    </DockPanel>

                    <!-- Tabel -->
                    <DataGrid x:Name="AboutGrid"
                              ItemsSource="{Binding AboutList}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Margin="0,20,0,0"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeight="60"
                              FontSize="13"
                              Background="White"
                              AlternatingRowBackground="#FAFAFA">

                        <!-- Header Style -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="Foreground" Value="#111827"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#e6f0ff"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,0,0,0"/>
                            </Style>
                        </DataGrid.Resources>

                        <!-- Kolom Data -->
                        <DataGrid.Columns>
                            <!-- Kolom ID -->
                            <DataGridTemplateColumn Header="ID" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}"
                           Padding="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom Nama Hotel -->
                            <DataGridTemplateColumn Header="Nama Hotel" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NamaHotel}"
                           Padding="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom Foto -->
                            <DataGridTemplateColumn Header="Foto" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Foto}"
                       Width="70"
                       Height="50"
                       Stretch="UniformToFill"
                       Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom Alamat -->
                            <DataGridTemplateColumn Header="Alamat" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Alamat}"
                           TextWrapping="Wrap"
                           Padding="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom No. Telp -->
                            <DataGridTemplateColumn Header="No. Telp" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NoTelp}"
                           Padding="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom Email -->
                            <DataGridTemplateColumn Header="Email" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Email}"
                           Padding="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom Kelas -->
                            <DataGridTemplateColumn Header="Kelas" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kelas}"
                           Padding="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom Deskripsi -->
                            <DataGridTemplateColumn Header="Deskripsi" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Deskripsi}"
                           TextWrapping="Wrap"
                           Padding="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom Aksi -->
                            <DataGridTemplateColumn Header="Aksi" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️" Margin="2" Padding="5,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Edit_Click"/>
                                            <Button Content="🗑" Margin="2" Padding="5,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="Red"
                            Cursor="Hand"
                            Click="Delete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
