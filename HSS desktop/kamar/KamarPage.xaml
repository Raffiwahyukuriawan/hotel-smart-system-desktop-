<UserControl x:Class="HSS_desktop.KamarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid>
        <StackPanel>

            <!-- Statistik -->
            <UniformGrid Columns="4" Margin="10,10,10,15" HorizontalAlignment="Stretch">
                <Border Background="White" CornerRadius="8" Padding="15" Margin="5"
            BorderBrush="#E5E7EB" BorderThickness="1">
                    <TextBlock Text="{Binding JumlahKosong, StringFormat=Kosong: {0}}" 
                   FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="15" Margin="5"
            BorderBrush="#E5E7EB" BorderThickness="1">
                    <TextBlock Text="{Binding JumlahTerisi, StringFormat=Terisi: {0}}" 
                   FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="15" Margin="5"
            BorderBrush="#E5E7EB" BorderThickness="1">
                    <TextBlock Text="{Binding JumlahKategori, StringFormat=Kategori: {0}}" 
                   FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="15" Margin="5"
            BorderBrush="#E5E7EB" BorderThickness="1">
                    <TextBlock Text="{Binding TotalKamar, StringFormat=Total Kamar: {0}}" 
                   FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                </Border>
            </UniformGrid>

            <!-- Header Bar -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tambah Kamar -->
                <Button Grid.Column="2"
                        Content="＋ Tambah Kamar"
                        Background="Black" Foreground="White"
                        FontWeight="Bold"
                        Height="35" Padding="10,0"
                        BorderThickness="0" Margin="10,0,30,0"
                        Cursor="Hand"
                        Click="TambahKamar_Click"/>
            </Grid>

            <!-- Card Kamar dari ItemsControl -->
            <ItemsControl ItemsSource="{Binding Kamars}" Width="964">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Margin="10" CornerRadius="8"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="8" ShadowDepth="2"/>
                            </Border.Effect>

                            <StackPanel>
                                <!-- Gambar + Badge status -->
                                <Grid>
                                    <!-- Foto kamar -->
                                    <Image Source="{Binding foto_kamar, TargetNullValue=/Assets/noimage.png, FallbackValue=/Assets/noimage.png}"
                               Height="180" Stretch="Fill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,300,180" RadiusX="8" RadiusY="8"/>
                                        </Image.Clip>
                                    </Image>

                                    <!-- Badge Status -->
                                    <Border CornerRadius="5" Padding="5,2" 
                                Background="White" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" 
                                Margin="8">
                                        <TextBlock Text="{Binding status}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{Binding status}"/>
                                    </Border>
                                </Grid>

                                <!-- Isi card -->
                                <StackPanel Margin="10">
                                    <TextBlock Text="{Binding nama_kamar}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding nama}" Foreground="Gray" FontSize="12"/>

                                    <!-- Harga & Kapasitas sejajar -->
                                    <Grid Margin="0,5,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Harga, StringFormat='Rp {0:N0},00'}" 
                   FontWeight="SemiBold" FontSize="13" Grid.Column="0"/>

                                        <TextBlock Text="{Binding kapasitas, StringFormat='{}{0} tamu'}" 
                   Foreground="Gray" FontSize="12" Grid.Column="1" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Tombol Update & Delete sejajar -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="✏ Edit"
                Background="#E0F2FE" Foreground="#0369A1"
                BorderBrush="#BAE6FD" BorderThickness="1"
                Height="30" Margin="2" FontWeight="SemiBold" Cursor="Hand"
                Click="EditKamar_Click"/>

                                        <Button Grid.Column="1" Content="🗑 Hapus"
                Background="#FEE2E2" Foreground="#991B1B"
                BorderBrush="#FECACA" BorderThickness="1"
                Height="30" Margin="2" FontWeight="SemiBold" Cursor="Hand"
                Click="HapusKamar_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Grid>
</UserControl>
