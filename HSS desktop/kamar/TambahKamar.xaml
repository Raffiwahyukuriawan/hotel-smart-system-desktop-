<Window x:Class="HSS_desktop.kamar.TambahKamar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Kamar"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="#66000000">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="12" Padding="25"
                Width="480" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <!-- HEADER -->
                <DockPanel Margin="0 0 0 20">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#111827"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🛏️" FontSize="18" Foreground="White"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tambah Data Kamar"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#111827"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </DockPanel>

                <!-- Nama Kamar -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="🛏️ Nama Kamar" FontSize="13" FontWeight="Bold"
               Foreground="#374151" Margin="5,0,0,5"/>
                    <TextBox x:Name="txtNamaKamar" FontSize="14" Padding="8"
             BorderBrush="#D1D5DB" BorderThickness="1"
             Background="#F9FAFB"/>
                </StackPanel>

                <!-- Kategori -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="📂 Kategori" FontSize="13" FontWeight="Bold"
       Foreground="#374151" Margin="5,0,0,5"/>
                    <ComboBox x:Name="cmbKategori" FontSize="14" Padding="5"
      BorderBrush="#D1D5DB" BorderThickness="1"
      Background="#F9FAFB" Width="425"
      DisplayMemberPath="NamaKategori"   
        SelectedValuePath="Id"/>
                </StackPanel>

                <!-- Foto Kamar -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="🖼️ Foto Kamar" FontSize="13" FontWeight="Bold"
               Foreground="#374151" Margin="5,0,0,5"/>
                    <TextBox x:Name="txtFotoKamar" FontSize="14" Padding="8"
             BorderBrush="#D1D5DB" BorderThickness="1"
             Background="#F9FAFB"/>
                </StackPanel>

                <!-- Status -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="📶 Status" FontSize="13" FontWeight="Bold"
               Foreground="#374151" Margin="5,0,0,5"/>
                    <ComboBox x:Name="cmbStatus" FontSize="14" Padding="5"
              BorderBrush="#D1D5DB" BorderThickness="1"
              Background="#F9FAFB" Width="425">
                        <ComboBoxItem Content="kosong" IsSelected="True"/>
                        <ComboBoxItem Content="terisi"/>
                    </ComboBox>
                </StackPanel>

                <!-- TOMBOL -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Batal"
                            Width="90" Height="34"
                            Background="White" Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            Cursor="Hand"
                            Click="Batal_Click"
                            FontWeight="SemiBold"/>

                    <Button Content="Simpan"
                            Width="90" Height="34" Margin="10,0,0,0"
                            Background="#111827" Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Simpan_Click"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
