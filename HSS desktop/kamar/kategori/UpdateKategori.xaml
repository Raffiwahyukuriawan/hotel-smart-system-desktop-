<Window x:Class="HSS_desktop.kamar.kategori.UpdateKategori"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Kategori Kamar"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="10" Padding="25" Width="420" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <!-- Judul -->
                <TextBlock Text="Update Kategori Kamar" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                <!-- Hidden ID -->
                <TextBox x:Name="txtId" Visibility="Collapsed"/>

                <!-- Nama -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="🏷️ Nama" 
               FontSize="13" 
               FontWeight="Bold" 
               Foreground="#374151" 
               Margin="5,0,0,5"/>
                    <TextBox x:Name="txtNama"
             FontSize="14"
             Padding="8"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="360"/>
                </StackPanel>

                <!-- Kapasitas -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="👥 Kapasitas" 
               FontSize="13" 
               FontWeight="Bold" 
               Foreground="#374151" 
               Margin="5,0,0,5"/>
                    <TextBox x:Name="txtKapasitas"
             FontSize="14"
             Padding="8"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="360"/>
                </StackPanel>

                <!-- Harga -->
                <StackPanel Margin="0 0 0 20">
                    <TextBlock Text="💰 Harga" 
               FontSize="13" 
               FontWeight="Bold" 
               Foreground="#374151" 
               Margin="5,0,0,5"/>
                    <TextBox x:Name="txtHarga"
             FontSize="14"
             Padding="8"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="360"/>
                </StackPanel>

                <!-- Tombol -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="Batal"
                            Width="90"
                            Height="32"
                            Background="White"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="Batal_Click" FontWeight="Bold"/>
                    <Button Content="Update"
                            Width="90"
                            Height="32"
                            Margin="10,0,0,0"
                            Background="Black"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Update_Click" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
