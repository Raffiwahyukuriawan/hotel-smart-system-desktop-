<Page x:Class="HSS_desktop.ManajemenKamar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Kamar"
      Width="1070">

    <ScrollViewer Padding="20" Width="1070">
        <StackPanel>
            <Grid Margin="0,0,0,15" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tombol Kamar -->
                <Button x:Name="BtnKamar"
                        Grid.Column="0"
                        Content="Kamar"
                        Click="BtnKamar_Click"
                        Padding="20,8"
                        Background="Black"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15,15,15,15">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Tombol Kategori -->
                <Button x:Name="BtnKategori"
                        Grid.Column="1"
                        Content="Kategori"
                        Click="BtnKategori_Click"
                        Padding="20,8"
                        Background="#E5E7EB"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15,15,15,15">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Tombol Riwayat -->
                <Button x:Name="BtnRiwayat"
                        Grid.Column="2"
                        Content="Riwayat"
                        Click="BtnRiwayat_Click"
                        Padding="20,8"
                        Background="#E5E7EB"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15,15,15,15">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Container -->
            <Border Background="White" CornerRadius="8" Padding="0,0,0,0" 
                    BorderBrush="#E5E7EB" BorderThickness="1">

                <StackPanel>
                    <!-- Konten dinamis -->
                    <ContentControl x:Name="MainContent" Margin="0,0,0,15"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
