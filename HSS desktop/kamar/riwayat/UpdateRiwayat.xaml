<Window x:Class="HSS_desktop.kamar.riwayat.UpdateRiwayat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Riwayat Kamar"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="10" Padding="25" Width="420" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <!-- Judul -->
                <TextBlock Text="Update Riwayat Kamar" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                <!-- Hidden ID -->
                <TextBox x:Name="txtId" Visibility="Collapsed"/>

                <!-- Kamar ID -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="🏠 Kamar ID" 
               FontSize="14" 
               FontWeight="Bold" 
               Foreground="#374151"
               Margin="5,0,0,5"/>
                    <TextBox x:Name="txtKamarId"
             FontSize="14"
             Padding="5"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="360"/>
                </StackPanel>

                <!-- Tamu ID -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="👤 Tamu ID" 
               FontSize="14" 
               FontWeight="Bold" 
               Foreground="#374151"
               Margin="5,0,0,5"/>
                    <TextBox x:Name="txtTamuId"
             FontSize="14"
             Padding="5"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="360"/>
                </StackPanel>

                <!-- Check In -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="📅 Tanggal Check In" 
               FontSize="14" 
               FontWeight="Bold" 
               Foreground="#374151"
               Margin="5,0,0,5"/>
                    <DatePicker x:Name="dpCheckIn"
                FontSize="14"
                Padding="5"
                BorderBrush="#ced4da"
                BorderThickness="1"
                Background="#fff"
                Width="360"/>
                </StackPanel>

                <!-- Check Out -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="📅 Tanggal Check Out" 
               FontSize="14" 
               FontWeight="Bold" 
               Foreground="#374151"
               Margin="5,0,0,5"/>
                    <DatePicker x:Name="dpCheckOut"
                FontSize="14"
                Padding="5"
                BorderBrush="#ced4da"
                BorderThickness="1"
                Background="#fff"
                Width="360"/>
                </StackPanel>

                <!-- Status -->
                <StackPanel Margin="0 0 0 20">
                    <TextBlock Text="📌 Status Pesanan" 
               FontSize="14" 
               FontWeight="Bold" 
               Foreground="#374151"
               Margin="5,0,0,5"/>
                    <ComboBox x:Name="cmbStatus"
              FontSize="14"
              Padding="5"
              BorderBrush="#ced4da"
              BorderThickness="1"
              Background="#fff"
              Width="360">
                        <ComboBoxItem Content="Ditempati"/>
                        <ComboBoxItem Content="Selesai"/>
                        <ComboBoxItem Content="Dibatalkan"/>
                    </ComboBox>
                </StackPanel>
                
                <!-- Tombol -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="Batal"
                            Width="90"
                            Height="32"
                            Background="White"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="Batal_Click" FontWeight="Bold"/>
                    <Button Content="Update"
                            Width="90"
                            Height="32"
                            Margin="10,0,0,0"
                            Background="Black"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Update_Click" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
