<Window x:Class="HSS_desktop.tamu.UpdateTamu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Data Tamu"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="10" Padding="25" Width="460" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <!-- Judul -->
                <TextBlock Text="Update Data Tamu" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                <!-- Hidden ID -->
                <TextBox x:Name="txtId" Visibility="Collapsed"/>

                <!-- User Id -->
                <!-- User ID -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="🧑‍💻 User ID"
               FontSize="14"
               FontWeight="SemiBold"
               Margin="5,0,0,5"
               Foreground="#111827"/>
                    <TextBox x:Name="txtUserId"
             FontSize="14"
             Padding="5"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="398"
             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nama Pemesan -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="🏷️ Nama Pemesan"
               FontSize="14"
               FontWeight="SemiBold"
               Margin="5,0,0,5"
               Foreground="#111827"/>
                    <TextBox x:Name="txtNamaPemesan"
             FontSize="14"
             Padding="5"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="398"
             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- No Telp -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="📞 No. Telepon"
               FontSize="14"
               FontWeight="SemiBold"
               Margin="5,0,0,5"
               Foreground="#111827"/>
                    <TextBox x:Name="txtNoTelp"
             FontSize="14"
             Padding="5"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="398"
             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Jumlah Tamu -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="👥 Jumlah Tamu"
               FontSize="14"
               FontWeight="SemiBold"
               Margin="5,0,0,5"
               Foreground="#111827"/>
                    <TextBox x:Name="txtJumlahTamu"
             FontSize="14"
             Padding="5"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="398"
             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Tombol -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="Batal"
                            Width="90" Height="32"
                            Background="White" Foreground="#374151"
                            BorderBrush="#D1D5DB" BorderThickness="1"
                            Cursor="Hand" Click="Batal_Click" FontWeight="Bold"/>
                    <Button Content="Update"
                            Width="90" Height="32" Margin="10,0,0,0"
                            Background="Black" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="Update_Click" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
