<Window x:Class="HSS_desktop.Invoice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice Hotel" Height="800" Width="850" Background="#f0f0f0">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" Padding="40" Margin="20" CornerRadius="5" BorderBrush="#ddd" BorderThickness="1">
            <StackPanel>

                <!-- HEADER -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="INVOICE" FontSize="48" FontWeight="Normal"/>
                        <TextBlock><Run FontWeight="Bold">Invoice number:</Run> <TextBlock x:Name="txtInvoiceNumber"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Date of issue:</Run> <TextBlock x:Name="txtInvoiceDate"/></TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Padding="10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="HOTEL" FontWeight="Bold" />
                            <TextBlock Text="🏢" FontSize="40" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- DETAILS -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Billed to" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtNamaTamu"/>
                        <TextBlock x:Name="txtNoTelp"/>
                        <TextBlock><Run FontWeight="Bold">Jumlah Tamu:</Run> <TextBlock x:Name="txtJumlahTamu"/></TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Detail Pesanan" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock><Run FontWeight="Bold">Tanggal:</Run> <TextBlock x:Name="txtTanggal"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Jam Makan:</Run> <TextBlock x:Name="txtJamMakan"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Status:</Run> <TextBlock x:Name="txtStatusPesanan"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Catatan:</Run> <TextBlock x:Name="txtCatatanKhusus"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Check In:</Run> <TextBlock x:Name="txtCheckIn"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Check Out:</Run> <TextBlock x:Name="txtCheckOut"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Status Kamar:</Run> <TextBlock x:Name="txtStatusKamar"/></TextBlock>
                    </StackPanel>
                </Grid>

                <!-- TABLE -->
                <DataGrid x:Name="dataGridItems" AutoGenerateColumns="False" HeadersVisibility="Column" Margin="0,0,0,30" Height="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost}" Width="100" />
                        <DataGridTextColumn Header="Qty / Hr rate" Binding="{Binding Quantity}" Width="100" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- SUMMARY -->
                <StackPanel HorizontalAlignment="Right" Width="300">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Subtotal"/>
                        <TextBlock x:Name="txtSubtotal"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Discount"/>
                        <TextBlock Text="$0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tax"/>
                        <TextBlock Text="$0"/>
                    </StackPanel>

                    <Border Background="#6c757d" Padding="10" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Invoice total" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTotal" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TERMS -->
                <TextBlock Text="Terms: Please pay invoice by MM/DD/YYYY" FontSize="12" Margin="0,30,0,0"/>

                <!-- FOOTER -->
                <TextBlock Text="FreshBooks makes it easier to get paid faster." FontSize="10" TextAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
