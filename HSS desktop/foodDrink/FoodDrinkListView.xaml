<UserControl x:Class="HSS_desktop.FoodDrinkListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HSS_desktop"
             Height="Auto" Width="Auto">

    <StackPanel>
        <!-- Toolbar -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tombol Tambah -->
            <Button Grid.Column="1"
                    Content="＋ Tambah Menu"
                    Background="Black" Foreground="White"
                    FontWeight="Bold"
                    Height="35" Padding="10,0"
                    BorderThickness="0" 
                    Cursor="Hand"
                    Click="TambahFoodDrink_Click"/>
        </Grid>

        <!-- Card List -->
            <ItemsControl ItemsSource="{Binding FoodDrinkList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Margin="10" CornerRadius="8"
                                Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="8" ShadowDepth="2"/>
                            </Border.Effect>

                            <StackPanel>
                            <Grid>
                                <!-- Foto kamar -->
                                <Image Source="{Binding Foto, TargetNullValue=/Assets/noimage.png, FallbackValue=/Assets/noimage.png}" 
                                       Height="180" Stretch="Fill">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,300,180" RadiusX="8" RadiusY="8"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Badge Status -->
                                <Border CornerRadius="5" Padding="5,2" 
                                 Background="White" 
                                 HorizontalAlignment="Right" VerticalAlignment="Top" 
                                 Margin="8">
                                    <TextBlock Text="{Binding Kategori}"
                                    FontSize="12" FontWeight="Bold"
                                    Foreground="{Binding Kategori}"/>
                                </Border>
                            </Grid>

                                <StackPanel Margin="10">
                                    <!-- Nama Menu -->
                                    <TextBlock Text="{Binding Nama}" FontWeight="Bold" FontSize="16"/>

                                    <!-- Harga -->
                                <TextBlock Text="{Binding Harga, StringFormat=Rp {0:N0}}" Foreground="Black" FontWeight="SemiBold" Grid.Column="0" FontSize="13" Margin="0,5,0,0"/>

                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="✏ Edit"
                                            Background="#E0F2FE" Foreground="#0369A1"
                                            BorderBrush="#BAE6FD" BorderThickness="1"
                                            Height="30" Margin="2" FontWeight="SemiBold" Cursor="Hand"
                                            Click="Edit_Click"/>

                                        <Button Grid.Column="1" Content="🗑 Hapus"
                                            Background="#FEE2E2" Foreground="#991B1B"
                                            BorderBrush="#FECACA" BorderThickness="1"
                                            Height="30" Margin="2" FontWeight="SemiBold" Cursor="Hand"
                                            Click="Edit_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </StackPanel>
</UserControl>
