<Window x:Class="HSS_desktop.foodDrink.UpdateMakananMinuman"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Data Makanan/Minuman"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="10" Padding="25" Width="460" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <!-- Judul -->
                <TextBlock Text="Update Data Makanan/Minuman" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                <!-- Hidden ID -->
                <TextBox x:Name="txtId" Visibility="Collapsed"/>

                <!-- Kategori -->
                <!-- Kategori -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="📦 Kategori" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="5,0,0,5"/>
                    <ComboBox x:Name="cmbKategori" Width="425" Height="35">
                        <ComboBoxItem Content="Makanan"/>
                        <ComboBoxItem Content="Minuman"/>
                    </ComboBox>
                </StackPanel>

                <!-- Foto -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="🖼️ URL Foto" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="5,0,0,5"/>
                    <TextBox x:Name="txtFoto"
             FontSize="14" Padding="5"
             BorderBrush="#ced4da" BorderThickness="1"
             Background="#fff"
             Width="425"/>
                </StackPanel>

                <!-- Nama -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="🍽️ Nama Makanan/Minuman" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="5,0,0,5"/>
                    <TextBox x:Name="txtNama"
             FontSize="14" Padding="5"
             BorderBrush="#ced4da" BorderThickness="1"
             Background="#fff"
             Width="425"/>
                </StackPanel>

                <!-- Harga -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="💰 Harga" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="5,0,0,5"/>
                    <DockPanel Height="40">
                        <TextBox x:Name="txtHarga"
                 FontSize="14" Padding="5"
                 BorderBrush="#ced4da" BorderThickness="1"
                 Background="#fff"
                 Width="425"
                 PreviewTextInput="NumberOnly_PreviewTextInput"/>
                    </DockPanel>
                </StackPanel>


                <!-- Tombol -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="Batal"
                            Width="90" Height="32"
                            Background="White" Foreground="#374151"
                            BorderBrush="#D1D5DB" BorderThickness="1"
                            Cursor="Hand" Click="Batal_Click" FontWeight="Bold"/>
                    <Button Content="Update"
                            Width="90" Height="32" Margin="10,0,0,0"
                            Background="Black" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="Update_Click" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
