<Page x:Class="HSS_desktop.FoodDrinkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Makanan &amp; Minuman"
      Width="1070">

    <ScrollViewer Padding="20" Width="1070">
        <StackPanel>
            <Grid Margin="0,0,0,15" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tombol kiri -->
                <Button x:Name="BtnFoodDrink"
                    Grid.Column="0"
                    Content="Menu Makanan &amp; Minuman"
                    Click="BtnFoodDrink_Click"
                    Padding="20,8"
                    Background="Black"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                        CornerRadius="15,15,15,15">
                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Tombol kanan -->
                <Button x:Name="BtnHistory"
            Grid.Column="1"
            Content="Riwayat Pesanan"
            Click="BtnHistory_Click"
            Padding="20,8"
            Background="#E5E7EB"
            Foreground="Black"
            FontWeight="Bold"
            BorderThickness="0"
            Cursor="Hand"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                        CornerRadius="15,15,15,15">
                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <!-- Container -->
            <Border Background="White" CornerRadius="8"  
                    BorderBrush="#E5E7EB" BorderThickness="1">

                <StackPanel>

                    <!-- Konten dinamis -->
                        <ContentControl x:Name="MainContent" Margin="10,10,10,10"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
