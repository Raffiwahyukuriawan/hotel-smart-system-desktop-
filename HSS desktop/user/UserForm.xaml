<Page x:Class="HSS_desktop.UserForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Form User"
      Background="#f8f9fa">

    <ScrollViewer Padding="20" Width="1070" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
            <Border Background="White" 
                    CornerRadius="10" 
                    Padding="30"
                    HorizontalAlignment="Center"
                    Width="700"
                    Effect="{DynamicResource DropShadow}">

                <StackPanel>
                    <!-- Judul -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                        <TextBlock Text="👤" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Tambah User"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#343a40"/>
                    </StackPanel>

                    <!-- Username -->
                    <TextBlock Text="Username"
                               FontSize="12"
                               Foreground="#495057"
                               Margin="0 0 0 5"/>
                    <DockPanel Height="40" Margin="0 0 0 15">
                        <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="txtUsername"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 VerticalAlignment="Center"
                                 Margin="5,0,0,0"
                                 Width="600"/>
                    </DockPanel>

                    <!-- Password -->
                    <TextBlock Text="Password"
                               FontSize="12"
                               Foreground="#495057"
                               Margin="0 0 0 5"/>
                    <DockPanel Height="40" Margin="0 0 0 15">
                        <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="5"/>
                        <PasswordBox x:Name="txtPassword"
                                     FontSize="14"
                                     Padding="5"
                                     BorderBrush="#ced4da"
                                     BorderThickness="1"
                                     Background="#fff"
                                     VerticalAlignment="Center"
                                     Margin="5,0,0,0"
                                     Width="600"/>
                    </DockPanel>

                    <!-- Role -->
                    <TextBlock Text="Role"
                               FontSize="12"
                               Foreground="#495057"
                               Margin="0 0 0 5"/>
                    <DockPanel Height="40" Margin="0 0 0 20">
                        <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="txtRole"
                                 FontSize="14"
                                 Padding="5"
                                 BorderBrush="#ced4da"
                                 BorderThickness="1"
                                 Background="#fff"
                                 VerticalAlignment="Center"
                                 Margin="5,0,0,0"
                                 Width="600"/>
                    </DockPanel>

                    <!-- Tombol -->
                    <Button Height="45"
                            Cursor="Hand"
                            Margin="0 10 0 0"
                            BorderBrush="Transparent"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Click="Simpan_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💾" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Simpan"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#0d6efd"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="22"
                                                    Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0b5ed7"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#0a58ca"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Tombol Kembali -->
                    <Button Height="45"
        Cursor="Hand"
        Margin="0 10 0 0"
        BorderBrush="Transparent"
        Foreground="White"
        FontSize="16"
        FontWeight="Bold"
        Click="Kembali_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⬅️" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Kembali"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#6c757d"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                CornerRadius="22"
                                Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5c636a"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#565e64"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
