<Window x:Class="HSS_desktop.UpdateUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update User"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="10" Padding="25" Width="420" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <!-- Judul -->
                <TextBlock Text="Update User" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                <!-- Hidden ID -->
                <TextBox x:Name="txtId" Visibility="Collapsed"/>

                <!-- Username -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="👤 Username"
               FontSize="14"
               FontWeight="Bold"
               Foreground="#374151"
               Margin="5,0,0,5"/>
                    <TextBox x:Name="txtUsername"
             FontSize="14"
             Padding="5"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="320"
             Height="35"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="🔒 Password"
               FontSize="14"
               FontWeight="Bold"
               Foreground="#374151"
               Margin="5,0,0,5"/>
                    <PasswordBox x:Name="txtPassword"
                 FontSize="14"
                 Padding="5"
                 BorderBrush="#ced4da"
                 BorderThickness="1"
                 Background="#fff"
                 Width="320"
                 Height="35"/>
                </StackPanel>

                <!-- Role -->
                <StackPanel Margin="0 0 0 20">
                    <TextBlock Text="🛡️ Role"
               FontSize="14"
               FontWeight="Bold"
               Foreground="#374151"
               Margin="5,0,0,5"/>
                    <ComboBox x:Name="txtRole"
              FontSize="14"
              Padding="5"
              BorderBrush="#ced4da"
              BorderThickness="1"
              Background="White"
              Width="320"
              Height="35">
                        <ComboBoxItem Content="admin"/>
                        <ComboBoxItem Content="tamu"/>
                        <ComboBoxItem Content="resepsionis"/>
                    </ComboBox>
                </StackPanel>

                <!-- Tombol -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="Batal"
                            Width="90"
                            Height="32"
                            Background="White"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="Batal_Click" FontWeight="Bold"/>
                    <Button Content="Update"
                            Width="90"
                            Height="32"
                            Margin="10,0,0,0"
                            Background="Black"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Update_Click" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
