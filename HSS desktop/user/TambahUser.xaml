<Window x:Class="HSS_desktop.TambahUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah User"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None">
    <!-- backdrop semi transparan -->

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="10" Padding="25" Width="420" BorderBrush="#E5E7EB" 
        BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <!-- Judul -->
                <TextBlock Text="Tambah User" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                <!-- Username -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="👤 Username"
               FontSize="14"
               FontWeight="Bold"
               Foreground="#374151"
               Margin="5,0,0,5"
               Width="298"/>
                    <TextBox x:Name="txtUsername"
             FontSize="14"
             Padding="5"
             BorderBrush="#ced4da"
             BorderThickness="1"
             Background="#fff"
             Width="298"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="🔒 Password"
               FontSize="14"
               FontWeight="Bold"
               Foreground="#374151"
               Margin="5,0,0,5"
               Width="298"/>
                    <PasswordBox x:Name="txtPassword"
                 FontSize="14"
                 Padding="5"
                 BorderBrush="#ced4da"
                 BorderThickness="1"
                 Background="#fff"
                 Width="298"/>
                </StackPanel>

                <!-- Role -->
                <StackPanel Margin="0 0 0 20">
                    <TextBlock Text="🛡️ Role"
               FontSize="14"
               FontWeight="Bold"
               Foreground="#374151"
               Margin="5,0,0,5"
               Width="298"/>
                    <ComboBox x:Name="txtRole"
              FontSize="14"
              Padding="5"
              BorderBrush="#ced4da"
              BorderThickness="1"
              Background="White"
              Width="298">
                        <ComboBoxItem Content="admin"/>
                        <ComboBoxItem Content="tamu"/>
                    </ComboBox>
                </StackPanel>

                <!-- Tombol -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="Batal"
                            Width="90"
                            Height="32"
                            Background="White"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="Batal_Click" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="6,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F3F4F6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Simpan"
                            Width="90"
                            Height="32"
                            Margin="10,0,0,0"
                            Background="Black"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Simpan_Click" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="6,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E40AF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
