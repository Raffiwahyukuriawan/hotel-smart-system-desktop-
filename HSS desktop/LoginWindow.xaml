<Window x:Class="HSS_desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - HSS Desktop"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Grid Background="#F3F4F6">
        <Border Background="White" CornerRadius="12" Padding="40"
                Width="380" BorderBrush="#E5E7EB" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel>

                <!-- Judul -->
                <TextBlock Text="Selamat Datang 👋"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Silakan login untuk melanjutkan"
                           Foreground="#6B7280"
                           FontSize="13"
                           Margin="0,5,0,30"
                           HorizontalAlignment="Center"/>

                <!-- Username -->
                <TextBlock Text="Username"
                           FontWeight="Bold"
                           Foreground="#374151"
                           FontSize="14"
                           Margin="5,0,0,5"/>
                <TextBox x:Name="txtUsername"
                         Width="298"
                         Height="35"
                         Padding="5"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Background="#FAFAFA"
                         FontSize="14"
                         Margin="0,0,0,15"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontWeight="Bold"
                           Foreground="#374151"
                           FontSize="14"
                           Margin="5,0,0,5"/>
                <PasswordBox x:Name="txtPassword"
                             Width="298"
                             Height="35"
                             Padding="5"
                             BorderBrush="#D1D5DB"
                             BorderThickness="1"
                             Background="#FAFAFA"
                             FontSize="14"
                             Margin="0,0,0,25"/>

                <!-- Tombol Login -->
                <Button Content="Masuk"
                        Width="298"
                        Height="38"
                        Background="Black"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Login_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Black"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1F2937"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Tombol Close -->
                <Button Content="Tutup"
                        Width="298"
                        Height="35"
                        Margin="0,10,0,0"
                        Background="White"
                        Foreground="Black"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Close_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
